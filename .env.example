# JARVIS AI Configuration

# Application
JARVIS_ENV=development
JARVIS_DEBUG=true
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000

# Database (SQLite para desenvolvimento, PostgreSQL para produção)
DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/jarvis

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Providers (deixe vazio se não estiver usando)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model Router
DEFAULT_MODEL_STRATEGY=AUTO
MAX_TOKENS_PER_REQUEST=100000
MAX_RECURSION_DEPTH=10
MAX_AGENT_CALLS_PER_MINUTE=100

# Features
ENABLE_VOICE=false
ENABLE_FILE_ACCESS=true
ENABLE_TERMINAL=false
ENABLE_WEB_ACCESS=false

# ElevenLabs (para voz - futuro)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
